@model List<ConsultasLINQ.Models.CursoAgrupadoViewModel>

@{
    ViewData["Title"] = "Consulta 9";
}

<div class="consulta-header">
    <h1>Consulta 9. Alumnos por curso</h1>
    <p>Se agrupan los alumnos por el nombre del curso y se cuenta el número de alumnos por grupo.</p>
</div>

@if (Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre del curso</th>
                <th>Número de alumnos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var curso in Model)
            {
                <tr>
                    <td>@curso.NombreCurso</td>
                    <td>@curso.NumeroAlumnos</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No existen grupos de cursos para esta consulta.</div>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al inicio</a>
