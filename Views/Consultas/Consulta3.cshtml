@model List<ConsultasLINQ.Models.AlumnoNotaViewModel>

@{
    ViewData["Title"] = "Consulta 3";
}

<div class="consulta-header">
    <h1>Consulta 3. Alumnos con buenas calificaciones</h1>
    <p>Se muestran los alumnos cuya nota media es igual o superior a 7.</p>
</div>

@if (Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Nota media</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alumno in Model)
            {
                <tr>
                    <td>@alumno.Nombre</td>
                    <td>@alumno.NotaMedia.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No existen alumnos para esta consulta.</div>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al inicio</a>
