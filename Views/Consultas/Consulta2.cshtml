@model List<ConsultasLINQ.Models.AlumnoEdadViewModel>

@{
    ViewData["Title"] = "Consulta 2";
}

<div class="consulta-header">
    <h1>Consulta 2. Alumnos mayores de 20 años</h1>
    <p>Se muestran los alumnos cuya edad es superior a 20 años, ordenados de menor a mayor edad.</p>
</div>

@if (Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Edad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alumno in Model)
            {
                <tr>
                    <td>@alumno.Nombre</td>
                    <td>@alumno.Edad</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No existen alumnos para esta consulta.</div>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al inicio</a>
